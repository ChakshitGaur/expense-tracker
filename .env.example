# Copy this file to .env (which is git-ignored) and adjust the values.

# Local development: set to 1. In production leave it unset or 0.
DJANGO_DEBUG=1

# Required when DJANGO_DEBUG is not 1. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=

# Comma-separated host names the site may be served from.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Production only (all optional):
# Full origins allowed to submit forms, e.g. https://expenses.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=
# Set to 1 when a proxy in front of the app terminates HTTPS (secure cookies + X-Forwarded-Proto).
DJANGO_BEHIND_HTTPS_PROXY=0
# Where the SQLite file lives (defaults to db.sqlite3 in the project folder).
# DJANGO_DB_PATH=/app/data/db.sqlite3
