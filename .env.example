# Copy this file to .env (which is git-ignored) and adjust the values.

# Local development: set to 1. In production leave it unset or 0.
DJANGO_DEBUG=1

# Required when DJANGO_DEBUG is not 1. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=

# Comma-separated host names the site may be served from.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
